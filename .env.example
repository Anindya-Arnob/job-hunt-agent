# Job Hunt Agent settings. Copy this file to ".env" (the installer does it for you) and edit what you need.
# Everything here is optional - the app runs with these defaults.

# ---- Claude ---------------------------------------------------------------------------------------
# EASIEST: install Claude Code and log in with your Claude Pro / Max subscription (see README).
# The app finds the `claude` command by itself and uses it for writing CVs, cover letters, web search,
# form answers and reading your job mails. Leave ANTHROPIC_API_KEY empty in that case.
#
# Alternative: an API key from https://console.anthropic.com (pay per use; also enables Claude for
# classifying and scoring every job). Without either, the app runs on offline rules.
ANTHROPIC_API_KEY=
# Full path to the claude command if it is not on your PATH (e.g. C:\Users\you\.local\bin\claude.exe)
CLAUDE_CLI_PATH=
# Model Claude Code uses for web search and form answers (sonnet / opus / haiku)
WEBSEARCH_CLI_MODEL=sonnet
# Models used with an API key (cheaper one for reading pages, stronger one for scoring and writing)
MODEL_FAST=claude-haiku-5-5
MODEL_SMART=claude-sonnet-5-5
DAILY_BUDGET_USD=5

# ---- Folders --------------------------------------------------------------------------------------
# Your job folder: CVs go to "<JOB_DIR>\Claude CV\<Company>\", Excel exports to "<JOB_DIR>\XL\".
# Default: Documents\JobHunt (Windows) or ./sample_job_dir (macOS / Linux)
JOB_DIR=
# Your name for file names (default: the name on your main CV)
OWNER_NAME=

# ---- Scoring & building ---------------------------------------------------------------------------
VERDICT_SKIP_BELOW=40
VERDICT_APPLY_FROM=65
BUILD_MIN_SCORE=40
MAX_BUILD_ATTEMPTS=3

# ---- CV building (also in Settings → CV building) ------------------------------------------------
# Model for the CV / the letter: haiku, sonnet, opus, fable or a full model id (empty = sonnet)
CV_MODEL=
LETTER_MODEL=
# Claude Code effort: low, medium, high (empty = default)
CV_EFFORT=
CV_PROJECTS=3
# Read your GitHub repos and pick the projects closest to each job (user empty = the link on your CV)
GITHUB_PROJECTS=true
GITHUB_USER=
# Optional: private repos and a higher GitHub limit
JOBHUNT_GITHUB_TOKEN=
ATS_TARGET=75
RECRUITER_REVIEW=true
HUMANIZE=true
STATE_AVAILABILITY=true
# Lean Claude Code calls: about 3,000 instead of 36,000 input tokens (skills, plugins, MCP off)
CLAUDE_LEAN=true

# ---- Search ---------------------------------------------------------------------------------------
# Human pacing for the browser agents
PAGE_DELAY_SECONDS=3
MAX_PAGES_PER_SEARCH=3
WEBSEARCH_ENABLED=true
WEBSEARCH_MAX_CALLS=30
# Morning run (only while the app is open)
SCHEDULE_ENABLED=false
SCHEDULE_TIME=07:10

# ---- Applying -------------------------------------------------------------------------------------
APPLY_DAILY_LIMIT=20

# ---- Server ---------------------------------------------------------------------------------------
HOST=127.0.0.1
PORT=8780
